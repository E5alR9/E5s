local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local player = Players.LocalPlayer

-- [[ 1. 開關邏輯：檢查是否已經執行過 ]]
local tagFileName = "AutoJumpTag_Running"
local existingTag = player.PlayerGui:FindFirstChild(tagFileName)

if existingTag then
    existingTag:Destroy()
    print("Auto Jump: OFF")
    return 
else
    local newTag = Instance.new("Folder")
    newTag.Name = tagFileName
    newTag.Parent = player.PlayerGui
    print("Auto Jump: ON")
end

-- [[ 2. 初始化變數與事件管理 ]]
local isHolding = false
local spacePressed = false 
local jumpInputObject = nil -- 用來追蹤按住跳躍鍵的那根手指
local connections = {} 

table.insert(connections, player.CharacterAdded:Connect(function()
    isHolding = false
    spacePressed = false
    jumpInputObject = nil
end))

-- [[ 3. 核心偵測函數：檢查觸控座標是否在跳躍按鈕內 ]]
local function isInsideJumpButton(pos)
    local touchGui = player.PlayerGui:FindFirstChild("TouchGui")
    local jumpBtn = touchGui and touchGui:FindFirstChild("JumpButton", true)
    if not jumpBtn then return false end
    
    local absPos = jumpBtn.AbsolutePosition
    local absSize = jumpBtn.AbsoluteSize
    
    -- 給手機觸控一點容錯空間（外擴 30 像素），避免手指太大按偏卻沒感應到
    local padding = 30 
    
    return pos.X >= (absPos.X - padding) and pos.X <= (absPos.X + absSize.X + padding)
       and pos.Y >= (absPos.Y - padding) and pos.Y <= (absPos.Y + absSize.Y + padding)
end

-- [[ 4. 全域輸入監聽 (繞過 Roblox 官方按鈕攔截) ]]
table.insert(connections, UserInputService.InputBegan:Connect(function(input, processed)
    -- 鍵盤空白鍵
    if input.KeyCode == Enum.KeyCode.Space then
        if not processed then spacePressed = true end
        return
    end
    
    -- 手機觸控 / 滑鼠點擊
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        if isInsideJumpButton(input.Position) then
            jumpInputObject = input -- 鎖定這根手指
            isHolding = true
        end
    end
end))

table.insert(connections, UserInputService.InputChanged:Connect(function(input)
    -- 如果手指在螢幕上滑動
    if input == jumpInputObject then
        -- 檢查手指是不是滑出了跳躍鍵的範圍
        if not isInsideJumpButton(input.Position) then
            jumpInputObject = nil
            isHolding = false
        end
    end
end))

table.insert(connections, UserInputService.InputEnded:Connect(function(input)
    -- 鬆開按鍵
    if input.KeyCode == Enum.KeyCode.Space then
        spacePressed = false
    elseif input == jumpInputObject then
        jumpInputObject = nil
        isHolding = false
    end
end))

-- [[ 5. 強力 Bhop 連跳執行邏輯 ]]
local heartbeatConn
heartbeatConn = RunService.Heartbeat:Connect(function()
    -- 關閉腳本時的清理
    if not player.PlayerGui:FindFirstChild(tagFileName) then 
        heartbeatConn:Disconnect() 
        for _, conn in ipairs(connections) do
            conn:Disconnect()
        end
        return 
    end

    if isHolding or spacePressed then
        local character = player.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        
        if humanoid and humanoid.Health > 0 then
            -- 你的思路：落地瞬間強制切換開關，逼迫引擎 100% 執行跳躍
            if humanoid.FloorMaterial ~= Enum.Material.Air then
                humanoid.Jump = false 
                humanoid.Jump = true  
            end
        end
    end
end)
