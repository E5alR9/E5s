local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local player = Players.LocalPlayer

-- [[ 1. 開關邏輯：檢查是否已經執行過 ]]
local tagFileName = "AutoJumpTag_Running"
local existingTag = player.PlayerGui:FindFirstChild(tagFileName)

if existingTag then
    existingTag:Destroy()
    print("Auto Jump: OFF")
    return 
else
    local newTag = Instance.new("Folder")
    newTag.Name = tagFileName
    newTag.Parent = player.PlayerGui
    print("Auto Jump: ON")
end

-- [[ 2. 初始化變數與事件管理 ]]
local isHolding = false
local spacePressed = false 
local connections = {} 

-- 當角色死亡/重生時，重置按鍵狀態，避免卡在跳躍狀態
table.insert(connections, player.CharacterAdded:Connect(function()
    isHolding = false
    spacePressed = false
end))

-- [[ 3. 鍵盤偵測 (電腦版專用) ]]
table.insert(connections, UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end 
    if input.KeyCode == Enum.KeyCode.Space then
        spacePressed = true
    end
end))

table.insert(connections, UserInputService.InputEnded:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.Space then
        spacePressed = false
    end
end))

-- [[ 4. 核心連跳邏輯 & 手機官方按鈕動態綁定 ]]
local heartbeatConn
heartbeatConn = RunService.Heartbeat:Connect(function()
    -- 如果開關標記被刪除（代表玩家再次執行了腳本，想要關閉功能），則清理所有事件並結束
    if not player.PlayerGui:FindFirstChild(tagFileName) then 
        heartbeatConn:Disconnect() 
        for _, conn in ipairs(connections) do
            conn:Disconnect()
        end
        return 
    end

    -- ================= 動態綁定官方手機按鈕 =================
    local touchGui = player.PlayerGui:FindFirstChild("TouchGui")
    local realBtn = touchGui and touchGui:FindFirstChild("JumpButton", true)
    
    if realBtn and not realBtn:GetAttribute("AutoJumpHooked") then
        realBtn:SetAttribute("AutoJumpHooked", true) 
        
        -- 使用多重事件綁定，確保不管是用手指點、滑鼠點，絕對能感應到
        local function setHolding() isHolding = true end
        local function setNotHolding() isHolding = false end

        -- 綁定 Input 事件
        table.insert(connections, realBtn.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
                setHolding()
            end
        end))
        table.insert(connections, realBtn.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
                setNotHolding()
            end
        end))
        
        -- 綁定 Touch 事件 (手機專屬防呆)
        table.insert(connections, realBtn.TouchBegan:Connect(setHolding))
        table.insert(connections, realBtn.TouchEnded:Connect(setNotHolding))
        
        -- 綁定 Mouse 事件 (相容模擬器與防滑出)
        table.insert(connections, realBtn.MouseButton1Down:Connect(setHolding))
        table.insert(connections, realBtn.MouseButton1Up:Connect(setNotHolding))
        table.insert(connections, realBtn.MouseLeave:Connect(setNotHolding)) -- 手指滑出按鈕範圍取消按住
    end

    -- ================= 強力 Bhop 連跳邏輯 ===================
    if isHolding or spacePressed then
        local character = player.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        
        if humanoid and humanoid.Health > 0 then
            -- 加入你的強制切換開關邏輯：
            -- 只有在碰觸地面時，才切換開關，100% 逼迫系統執行跳躍
            if humanoid.FloorMaterial ~= Enum.Material.Air then
                humanoid.Jump = false -- 先強制關閉，重置系統狀態
                humanoid.Jump = true  -- 瞬間開啟，觸發無縫起跳
            end
        end
    end
end)
