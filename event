local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local player = LocalPlayer
local PlayerGui = player:WaitForChild("PlayerGui")

-- ==========================
-- 參數設定
-- ==========================
local DANGER_RADIUS = 40              -- 鬼的危險警戒距離
local SAFE_HEIGHT_POS = Vector3.new(3000, 3005, 3000) -- 避難/待命傳送座標
local currentRemainingTime = 9999     -- 紀錄目前剩餘秒數

-- 啟動/關閉開關 (重複執行可切換)
if _G.AutoFarmActive then
    _G.AutoFarmActive = false
    print("🔴 已停止：全自動收集")
    return 
end

_G.AutoFarmActive = true
_G.IsBusy = false 

-- ==========================================
-- 1. 時間解析函式
-- ==========================================
local function parseTimeToSeconds(cleanText)
    if not cleanText or type(cleanText) ~= "string" or cleanText == "" then 
        return 9999 
    end
    
    -- 匹配 MM:SS 格式 (例如 "1:10" 或 "0:05")
    local mins, secs = cleanText:match("(%d+)%s*:%s*(%d+)")
    if mins and secs then
        return (tonumber(mins) * 60) + tonumber(secs)
    end
    
    -- 匹配純數字格式 (例如 "5" 或 "05")
    local justSecs = cleanText:match("(%d+)")
    if justSecs then
        return tonumber(justSecs)
    end
    
    return 9999
end

-- ==========================================
-- 2. 直接讀取原版 Timer
-- ==========================================
task.spawn(function()
    local function getTargetTimer()
        local ok, result = pcall(function()
            return PlayerGui.Game.HUD.Overlay.RoundOverlay.RoundTimer.IngameRoundTimer.Timer
        end)
        if ok and result and result:IsA("TextLabel") then
            return result
        end
        return nil
    end

    local targetTimer = getTargetTimer()
    while _G.AutoFarmActive and not targetTimer do
        targetTimer = getTargetTimer()
        task.wait(0.5)
    end

    if targetTimer then
        local lastTimePrinted = -1
        local function updateTime()
            if not _G.AutoFarmActive then return end
            local txt = (targetTimer.ContentText ~= "" and targetTimer.ContentText) or targetTimer.Text
            local secs = parseTimeToSeconds(txt)
            currentRemainingTime = secs
            
            if secs <= 5 and secs ~= lastTimePrinted then
                lastTimePrinted = secs
                print("⏱️ [Timer監聽] 讀取 ContentText: [" .. tostring(txt) .. "] -> 解析秒數: [" .. tostring(secs) .. "]")
            end
        end

        targetTimer:GetPropertyChangedSignal("ContentText"):Connect(updateTime)
        targetTimer:GetPropertyChangedSignal("Text"):Connect(updateTime)
        
        while _G.AutoFarmActive do
            updateTime()
            task.wait(0.2)
        end
    end
end)

-- ==========================
-- 3. 取得資料夾與工具函式
-- ==========================
local function getGameFolders()
    local mapFolder = workspace:FindFirstChild("Map") 
                    or (workspace:FindFirstChild("Game") and workspace.Game:FindFirstChild("Map"))
                    
    local effectsFolder = workspace:FindFirstChild("Effects") 
                       or (workspace:FindFirstChild("Game") and workspace.Game:FindFirstChild("Effects"))

    local playersFolder = workspace:FindFirstChild("Players") 
                        or (workspace:FindFirstChild("Game") and workspace.Game:FindFirstChild("Players"))

    return playersFolder, mapFolder, effectsFolder
end

local function isInsideForbiddenZone(pos)
    local isForbidden = false
    pcall(function()
        local _, mapFolder, _ = getGameFolders()
        local safeZonesFolder = mapFolder and mapFolder:FindFirstChild("SafeZones")
        
        if safeZonesFolder then
            for _, zone in ipairs(safeZonesFolder:GetChildren()) do
                if zone:IsA("BasePart") then
                    local localPos = zone.CFrame:PointToObjectSpace(pos)
                    if math.abs(localPos.X) <= (zone.Size.X / 2) and
                       math.abs(localPos.Y) <= (zone.Size.Y / 2) and
                       math.abs(localPos.Z) <= (zone.Size.Z / 2) then
                        isForbidden = true
                        break 
                    end
                end
            end
        end
    end)
    return isForbidden
end

local function getObjInfo(item)
    if not item then return nil, nil end
    if item:IsA("BasePart") then
        return item.CFrame, item.Position
    elseif item:IsA("Model") and item.PrimaryPart then
        return item.PrimaryPart.CFrame, item.PrimaryPart.Position
    end
    return nil, nil
end

local function getActiveAIs(playersFolder)
    local ais = {}
    if playersFolder then
        for _, item in ipairs(playersFolder:GetChildren()) do
            local isRealPlayer = Players:GetPlayerFromCharacter(item)
            if item:FindFirstChild("Hitbox") or (not isRealPlayer and item:FindFirstChild("HumanoidRootPart")) then
                local _, pos = getObjInfo(item)
                if pos then table.insert(ais, pos) end
            end
        end
    end
    return ais
end

local function isSafe(targetPos, ais)
    if not targetPos then return false end
    for _, aiPos in ipairs(ais) do
        if (targetPos - aiPos).Magnitude < DANGER_RADIUS then
            return false
        end
    end
    if isInsideForbiddenZone(targetPos) then
        return false
    end
    return true
end

-- ==========================
-- 🏃 4. 主程序：自動收集與防鬼待命
-- ==========================
local targetAges = {}
local hasEvacuated = false
local previousTime = 9999 -- 用於記錄上一幀的時間，以精準判斷回合重置

task.spawn(function()
    while _G.AutoFarmActive do
        _G.IsBusy = false 
        local character = player.Character
        local rootPart = character and character:FindFirstChild("HumanoidRootPart")
        
        -- 清理過期物件紀錄
        for t, _ in pairs(targetAges) do
            if not t or not t.Parent then
                targetAges[t] = nil
            end
        end

        -- 【關鍵修正】只有當秒數從「<= 5 秒」跳變回「> 10 秒」時，才認定為真實的新回合開始
        if previousTime <= 5 and currentRemainingTime > 10 then
            hasEvacuated = false
            print("🔄 新回合開始，重置避難標記！")
        end
        previousTime = currentRemainingTime -- 更新時間紀錄
        
        if rootPart then
            local playersFolder, mapFolder, effectsFolder = getGameFolders()
            
            if playersFolder or effectsFolder then
                local ais = getActiveAIs(playersFolder)
                local myPos = rootPart.Position
                
                -- 【判斷 1】倒數剩餘 <= 5 秒：強制飛往高空待命
                if currentRemainingTime <= 5 then
                    _G.IsBusy = true
                    if not hasEvacuated then
                        rootPart.CFrame = CFrame.new(SAFE_HEIGHT_POS)
                        hasEvacuated = true
                        print("⏳ [安全避難] 倒數剩餘 " .. tostring(currentRemainingTime) .. " 秒！已飛往高空待命點！")
                    end
                    task.wait(0.2)
                    continue
                end

                -- 【判斷 2】誤入禁區或周圍有鬼：傳送避難
                if isInsideForbiddenZone(myPos) or not isSafe(myPos, ais) then
                    _G.IsBusy = true
                    if not hasEvacuated then
                        rootPart.CFrame = CFrame.new(SAFE_HEIGHT_POS)
                        hasEvacuated = true
                        print("⚠️ 偵測到危險(鬼或禁區)！已飛往高空避難點")
                    end
                    task.wait(0.5)
                    continue
                end
                
                -- 搜尋目標
                local allTargets = {}
                local ticketsFolder = effectsFolder and effectsFolder:FindFirstChild("Tickets")
                
                if ticketsFolder then
                    for _, item in ipairs(ticketsFolder:GetChildren()) do
                        table.insert(allTargets, item)
                    end
                end
                
                if playersFolder then
                    for _, item in ipairs(playersFolder:GetChildren()) do
                        local isRealPlayer = Players:GetPlayerFromCharacter(item)
                        local isAI = item:FindFirstChild("Hitbox")
                        if not isRealPlayer and not isAI then
                            table.insert(allTargets, item)
                        end
                    end
                end
                
                local safeTargets = {}
                for _, target in ipairs(allTargets) do
                    if not targetAges[target] then
                        targetAges[target] = os.clock()
                    end
                    
                    local _, targetPos = getObjInfo(target)
                    local isOldEnough = (os.clock() - targetAges[target]) >= 5
                    
                    if targetPos and isSafe(targetPos, ais) and isOldEnough then
                        table.insert(safeTargets, target)
                    end
                end
                
                -- 執行撿取
                if #safeTargets > 0 then
                    _G.IsBusy = true 
                    -- 只要重新發現安全目標，便解除避難標記，恢復自動傳送撿取
                    hasEvacuated = false 
                    
                    local randomTarget = safeTargets[math.random(1, #safeTargets)]
                    local cf, pos = getObjInfo(randomTarget)
                    
                    if cf and currentRemainingTime > 5 then
                        rootPart.CFrame = cf
                    end
                else
                    -- 場上無安全目標時飛往待命點 (只觸發一次)
                    if not hasEvacuated then
                        rootPart.CFrame = CFrame.new(SAFE_HEIGHT_POS)
                        hasEvacuated = true
                        print("⚠️ 場上無安全目標，飛往待命點放開控制")
                    end
                end
            end
        else
            task.wait(1)
        end
        task.wait(0.1) 
    end
end)
