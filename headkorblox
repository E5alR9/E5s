local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local lp = Players.LocalPlayer

-- [[ 設定 ]]
-- 無頭 Mesh ID (僅適用於 R6 角色)
local HEADLESS_MESH_ID = "rbxassetid://6686307858"

-- ==========================================
-- 核心功能與驗證機制
-- ==========================================

-- 【新增】檢查是否為完整的 R6 角色/玩家模型
local function isValidCharacter(char)
    if not char or not char:IsA("Model") then return false end

    -- 必須具備的完整身體部位清單 (R6 標準結構)
    local requiredParts = {
        "Head",
        "Torso",
        "Left Arm",
        "Left Leg",
        "Right Arm",
        "Right Leg"
    }

    for _, partName in ipairs(requiredParts) do
        if not char:FindFirstChild(partName) then
            return false
        end
    end

    -- 必須含有 Humanoid
    if not char:FindFirstChildOfClass("Humanoid") then
        return false
    end

    return true
end

-- [[ 核心功能：應用外觀效果 (無頭 + 斷腳) ]]
local function applyAppearance(char)
    if not char then return end

    -- 驗證模型結構，如果不符合標準 R6 角色就不執行
    if not isValidCharacter(char) then
        return
    end
    
    -- 1. 處理 UI 控制台 (僅針對本地玩家自己)
    -- 當你重生時，確保你的 E5_Console 介面會重新顯示
    local charPlayer = Players:GetPlayerFromCharacter(char)
    if lp and (charPlayer == lp or char == lp.Character) then
        task.spawn(function()
            local gui = lp:WaitForChild("PlayerGui", 10)
            if gui then
                local console = gui:WaitForChild("E5_Console", 5)
                if console then 
                    console.Enabled = true 
                end
            end
        end)
    end

    -- 2. 外觀處理：無頭與斷腳
    task.spawn(function()
        -- 等待頭部加載，最長等待 10 秒
        local head = char:WaitForChild("Head", 10)
        if not head or not isValidCharacter(char) then return end
        
        task.wait(0.2) -- 稍微延長等待，確保所有裝飾品加載完畢

        -- [[ A. 無頭處理 (Headless) ]]
        -- 隱藏臉部貼圖 (Face) - 所有角色通用
        for _, obj in ipairs(head:GetChildren()) do
            if obj:IsA("Decal") or obj:IsA("Texture") then
                obj.Transparency = 1
            end
        end

        -- 判斷角色類型並執行對應的無頭邏輯
        if head:IsA("MeshPart") then
            -- [R15 角色]
            head.Transparency = 1
        else
            -- [R6 角色]
            -- R6 是普通 Part + SpecialMesh，可以修改 ID 來達成真正的無頭 Mesh
            local mesh = head:FindFirstChildOfClass("SpecialMesh")
            if not mesh then
                mesh = Instance.new("SpecialMesh", head)
            end
            
            if mesh then
                mesh.MeshId = HEADLESS_MESH_ID
                mesh.TextureId = "" -- 清空貼圖
                mesh.Scale = Vector3.new(1, 1, 1) -- 確保大小正常
                head.Transparency = 1 
            end
        end

        -- [[ B. 斷腳處理 (Korblox) ]]
        -- 執行原本的遠端斷腳腳本
        pcall(function()
            loadstring(game:HttpGet("https://raw.githubusercontent.com/E5alR9/E5s/refs/heads/main/bestkorblox"))()
        end)
    end)
end

-- ==========================================
-- [[ 系統啟動流程 (Workspace 全域監聽) ]]
-- ==========================================

local function processModelIfCharacter(model)
    if isValidCharacter(model) then
        task.spawn(applyAppearance, model)
    end
end

task.spawn(function()
    print("//// #### [M4] GLOBAL_APPEARANCE_SYSTEM_RUNNING #### ////")

    -- 1. 初次掃描 Workspace 底下的所有物件 (包含 Rigs, Players 等任意深層資料夾)
    for _, descendant in ipairs(Workspace:GetDescendants()) do
        if descendant:IsA("Humanoid") and descendant.Parent then
            processModelIfCharacter(descendant.Parent)
        end
    end

    -- 2. 動態監聽 Workspace 新增的 Humanoid (支援重生、新 Model 生成)
    Workspace.DescendantAdded:Connect(function(descendant)
        if descendant:IsA("Humanoid") then
            task.delay(0.3, function() -- 稍微等待角色零件載入齊全
                if descendant.Parent then
                    processModelIfCharacter(descendant.Parent)
                end
            end)
        end
    end)
end)
