local Workspace = game:GetService("Workspace")

local K_MESH_ID = "rbxassetid://101851696"
local K_TEXTURE_ID = "rbxassetid://101851254"
local K_COLOR = Color3.fromRGB(38, 65, 68) 

-- ==========================================
-- 狀態管理與切換邏輯
-- ==========================================

-- 初始化全局變數
if _G.KorbloxEnabled == nil then
    _G.KorbloxEnabled = false
end
_G.KorbloxConnections = _G.KorbloxConnections or {}

-- 切換開關狀態
_G.KorbloxEnabled = not _G.KorbloxEnabled

-- 清理舊的監聽器 (避免重複執行導致效能問題)
for _, conn in ipairs(_G.KorbloxConnections) do
    if conn.Connected then
        conn:Disconnect()
    end
end
table.clear(_G.KorbloxConnections)

-- 如果狀態是關閉，印出提示並停止執行後續代碼
if not _G.KorbloxEnabled then
    print("🔴 冰魔腿效果：已關閉 (下次重生或重新載入後腿部將恢復原狀)")
    return
end

print("🟢 冰魔腿效果：已開啟 (自動全域掃描 Workspace 中的角色 Model)")

-- ==========================================
-- 核心功能與驗證機制
-- ==========================================

-- 檢查是否為完整的 R6 角色/玩家模型
local function isValidCharacter(char)
    if not char or not char:IsA("Model") then return false end

    -- 必須具備的完整身體部位清單 (R6 標準結構)
    local requiredParts = {
        "Head",
        "Torso",
        "Left Arm",
        "Left Leg",
        "Right Arm",
        "Right Leg"
    }

    for _, partName in ipairs(requiredParts) do
        if not char:FindFirstChild(partName) then
            return false
        end
    end

    -- 必須含有 Humanoid
    if not char:FindFirstChildOfClass("Humanoid") then
        return false
    end

    return true
end

local function applyTargetColor(char)
    if not char or not _G.KorbloxEnabled then return end

    -- 等待部位載入（最多等待 3 秒）
    local rLeg = char:WaitForChild("Right Leg", 3)
    
    -- 驗證模型結構是否符合標準角色
    if not isValidCharacter(char) then
        return
    end

    if rLeg and _G.KorbloxEnabled then
        -- 1. 清理原版的 CharacterMesh，避免與 SpecialMesh 衝突
        for _, v in ipairs(char:GetChildren()) do
            if v:IsA("CharacterMesh") and v.BodyPart == Enum.BodyPart.RightLeg then
                v:Destroy()
            end
        end

        -- 2. 使用 SpecialMesh 替換 ID
        local mesh = rLeg:FindFirstChildOfClass("SpecialMesh")
        if not mesh then
            mesh = Instance.new("SpecialMesh", rLeg)
            mesh.Name = "KorbloxMesh"
        end

        mesh.MeshId = K_MESH_ID
        mesh.TextureId = K_TEXTURE_ID
        mesh.Scale = Vector3.new(1, 1, 1)

        -- 3. 微調右腿零件的材質與顏色
        rLeg.Color = K_COLOR
        rLeg.Transparency = 0
        rLeg.Material = Enum.Material.Plastic 
        
        -- 強力鎖定，防止被遊戲機制改回皮膚色
        task.spawn(function()
            while char and char.Parent and _G.KorbloxEnabled and isValidCharacter(char) do
                if rLeg.Color ~= K_COLOR then 
                    rLeg.Color = K_COLOR 
                end
                task.wait(1)
            end
        end)
    end
end

-- ==========================================
-- Workspace 自動掃描與監聽邏輯
-- ==========================================

local function processModelIfCharacter(model)
    if not _G.KorbloxEnabled then return end
    if isValidCharacter(model) then
        task.spawn(applyTargetColor, model)
    end
end

-- 1. 初次掃描 Workspace 底下的所有物件 (包含 Rigs, Players 等子資料夾)
for _, descendant in ipairs(Workspace:GetDescendants()) do
    if descendant:IsA("Humanoid") and descendant.Parent then
        processModelIfCharacter(descendant.Parent)
    end
end

-- 2. 監聽 Workspace 動態新增的 Humanoid (支援角色重生、新 Rig 生成等)
local descendantAddedConn = Workspace.DescendantAdded:Connect(function(descendant)
    if descendant:IsA("Humanoid") then
        task.delay(0.3, function() -- 稍微等待角色零件載入齊全
            if descendant.Parent then
                processModelIfCharacter(descendant.Parent)
            end
        end)
    end
end)

table.insert(_G.KorbloxConnections, descendantAddedConn)
