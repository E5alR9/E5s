    if not targetItem then
        StatusLabel.Text = "Please select a target item!"
        StatusLabel.TextColor3 = Color3.new(1, 0.3, 0.3)
        return
    end
    
    if not sourceItem then
        StatusLabel.Text = "Please select a source item!"
        StatusLabel.TextColor3 = Color3.new(1, 0.3, 0.3)
        return
    end

    ClearLog()
    AddLog("Starting transfer process...")
    StatusLabel.Text = "Processing..."
    StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 50)
    task.wait(0.05)

    local overallSuccess = true
    local allItems = GetAllCategoryItems(currentCategory)

    -- 1. 確定 Sources 陣列
    local sourcesToProcess = {}
    if sourceItem == "ALL" then
        sourcesToProcess = allItems
    else
        table.insert(sourcesToProcess, sourceItem)
    end

    -- 2. 開始逐一轉換，獨立捕獲每一個物品對的錯誤
    for _, sItem in ipairs(sourcesToProcess) do
        local targetsToProcess = {}
        if targetItem == "ALL" then
            for _, item in ipairs(allItems) do
                if item ~= sItem then
                    table.insert(targetsToProcess, item)
                end
            end
        else
            if targetItem ~= sItem then
                table.insert(targetsToProcess, targetItem)
            end
        end

        for _, tItem in ipairs(targetsToProcess) do
            local itemSuccess, itemErr = pcall(function()
                -- ModuleScript 的資料與 Sound 覆寫
                if sItem:IsA("ModuleScript") and tItem:IsA("ModuleScript") then
                    local sourceData = require(sItem)
                    local targetData = require(tItem)
                    
                    if type(sourceData) == "table" and type(targetData) == "table" then
                        local oldDisplayName = (type(sourceData.AppearanceInfo) == "table" and sourceData.AppearanceInfo.Name) or sItem.Name
                        local newDisplayName = (type(targetData.AppearanceInfo) == "table" and targetData.AppearanceInfo.Name) or tItem.Name
                        _G.NameSwaps[oldDisplayName] = newDisplayName
                        _G.NameSwaps[sItem.Name] = tItem.Name

                        local oldSound = type(sourceData.EmoteInfo) == "table" and sourceData.EmoteInfo.Sound
                        local newSound = type(targetData.EmoteInfo) == "table" and targetData.EmoteInfo.Sound
                        if oldSound and newSound then
                            _G.SoundSwaps[tostring(oldSound)] = tostring(newSound)
                        end

                        local function DeepCopy(orig)
                            local copy
                            if type(orig) == 'table' then
                                copy = {}
                                for orig_key, orig_value in pairs(orig) do
                                    copy[orig_key] = DeepCopy(orig_value)
                                end
                            else
                                copy = orig
                            end
                            return copy
                        end

                        -- 安全覆寫（防止 Table 被凍結導致整體中斷）
                        pcall(function() table.clear(sourceData) end)
                        for k, v in pairs(DeepCopy(targetData)) do
                            pcall(function() sourceData[k] = v end)
                        end
                    end
                end

                -- 複製模型與動畫
                for _, child in ipairs(tItem:GetChildren()) do
                    pcall(function()
                        child:Clone().Parent = sItem
                    end)
                end
            end)

            if itemSuccess then
                AddLog(string.format("[%s] -> [%s] done!", tItem.Name, sItem.Name))
            else
                overallSuccess = false
                AddLog(string.format("[%s] -> [%s] skipped (err)", tItem.Name, sItem.Name))
                warn(string.format("Swap failed between %s and %s: %s", tItem.Name, sItem.Name, tostring(itemErr)))
            end
            task.wait(0.02)
        end
    end

    -- 3. 手動觸發 UI 文字替換
    if localPlayer and localPlayer:FindFirstChild("PlayerGui") then
        for _, desc in ipairs(localPlayer.PlayerGui:GetDescendants()) do
            CheckAndReplaceText(desc)
        end
    end

    if overallSuccess then
        AddLog("All operations completed successfully!")
        StatusLabel.Text = "Transferred Completed!"
        StatusLabel.TextColor3 = Color3.new(0.3, 1, 0.3)
    else
        AddLog("Done with some skipped items.")
        StatusLabel.Text = "Completed with warnings"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 180, 50)
    end
    RefreshLists()
end)

SwitchTab("Emotes")
