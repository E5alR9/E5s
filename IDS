end

-- === 2. 全域 Sound 音效播放即時攔截器 ===
local function CheckAndReplaceSound(soundObj)
    if soundObj:IsA("Sound") then
        local currentSoundId = string.match(soundObj.SoundId, "%d+")
        if currentSoundId and _G.SoundSwaps[currentSoundId] then
            soundObj.SoundId = "rbxassetid://" .. tostring(_G.SoundSwaps[currentSoundId])
        end
    end
end

game.DescendantAdded:Connect(function(desc)
    if desc:IsA("Sound") then
        CheckAndReplaceSound(desc)
        desc:GetPropertyChangedSignal("SoundId"):Connect(function()
            CheckAndReplaceSound(desc)
        end)
        desc.Played:Connect(function()
            CheckAndReplaceSound(desc)
        end)
    end
end)

