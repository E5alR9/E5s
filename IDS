-- === 1. 全域 UI 文字自動替換監聽器 ===
local function CheckAndReplaceText(obj)
    if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
        for oldName, newName in pairs(_G.NameSwaps) do
            if string.find(obj.Text, oldName, 1, true) then
                obj.Text = string.gsub(obj.Text, oldName, newName)
            end
        end
    end
end

