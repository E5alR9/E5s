-- === 轉移與資料/音效覆寫邏輯 ===
ApplyBtn.MouseButton1Click:Connect(function()
    if not targetItem then
        StatusLabel.Text = "Please select a target item!"
        StatusLabel.TextColor3 = Color3.new(1, 0.3, 0.3)
        return
    end
    
    if not sourceItem then
        StatusLabel.Text = "Please select a source item!"
        StatusLabel.TextColor3 = Color3.new(1, 0.3, 0.3)
        return
    end

    local success, err = pcall(function()
        if sourceItem ~= targetItem then
            -- 1. 處理 ModuleScript 的資料與 Sound 替換
            if sourceItem:IsA("ModuleScript") and targetItem:IsA("ModuleScript") then
                local sourceData = require(sourceItem)
                local targetData = require(targetItem)
                
                -- 讀取與設置 Name 對照 (GUI 文字替換)
                local oldDisplayName = (sourceData.AppearanceInfo and sourceData.AppearanceInfo.Name) or sourceItem.Name
                local newDisplayName = (targetData.AppearanceInfo and targetData.AppearanceInfo.Name) or targetItem.Name
                _G.NameSwaps[oldDisplayName] = newDisplayName
                _G.NameSwaps[sourceItem.Name] = targetItem.Name

                -- 讀取與設置 Sound 對照
                local oldSound = sourceData.EmoteInfo and sourceData.EmoteInfo.Sound
                local newSound = targetData.EmoteInfo and targetData.EmoteInfo.Sound
                if oldSound and newSound then
                    _G.SoundSwaps[tostring(oldSound)] = tostring(newSound)
                end

                -- 深度複製 targetData 至 sourceData 表單中
                local function DeepCopy(orig)
                    local copy
                    if type(orig) == 'table' then
                        copy = {}
                        for orig_key, orig_value in pairs(orig) do
                            copy[orig_key] = DeepCopy(orig_value)
                        end
                    else
                        copy = orig
                    end
                    return copy
                end

                table.clear(sourceData)
                for k, v in pairs(DeepCopy(targetData)) do
                    sourceData[k] = v
                end
            end

            -- 2. 清空並複製子物件（模型/動畫等）
            sourceItem:ClearAllChildren()
            for _, child in ipairs(targetItem:GetChildren()) do
                child:Clone().Parent = sourceItem
            end

            -- 3. 手動掃描並更新一次目前的 PlayerGui
            if localPlayer and localPlayer:FindFirstChild("PlayerGui") then
                for _, desc in ipairs(localPlayer.PlayerGui:GetDescendants()) do
                    CheckAndReplaceText(desc)
                end
            end
        end
    end)
    
    if success then
        StatusLabel.Text = "Data, Sound & Name Transferred!"
        StatusLabel.TextColor3 = Color3.new(0.3, 1, 0.3)
        RefreshLists() 
        UpdatePreview() 
    else
        StatusLabel.Text = "Failed (Permission Denied)"
        warn(err)
    end
end)

