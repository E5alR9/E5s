-- --- Recursive Item Scanner ---
local function GetAllCategoryItems(catName)
    local results = {}
    if not ITEMS_FOLDER then return results end
    
    local function CollectFromFolder(folder)
        for _, child in ipairs(folder:GetChildren()) do
            local isTierFolder = child:IsA("Folder") and (
                string.match(child.Name, "^Tier%d+$") ~= nil or 
                string.find(child.Name, "Exclusive") ~= nil
            )
            if isTierFolder then
                CollectFromFolder(child)
            else
                table.insert(results, child)
            end
        end
    end

    for _, desc in ipairs(ITEMS_FOLDER:GetDescendants()) do
        if desc:IsA("Folder") and desc.Name == catName then
            CollectFromFolder(desc)
        end
    end
    
    return results
end

