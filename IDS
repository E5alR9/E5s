-- --- Strict Classification Scanner (只抓最上層 ModuleScript) ---
local function GetAllCategoryItems(catName)
    local results = {}
    local seen = {}
    if not ITEMS_FOLDER then return results end
    
    -- 1. 找出所有名稱為 "Emotes" 的資料夾
    local emoteFolders = {}
    for _, desc in ipairs(ITEMS_FOLDER:GetDescendants()) do
        if desc:IsA("Folder") and desc.Name == "Emotes" then
            table.insert(emoteFolders, desc)
        end
    end

    -- 檢查物品是否屬於 Emotes 資料夾內部
    local function IsUnderEmotes(obj)
        for _, eFolder in ipairs(emoteFolders) do
            if obj:IsDescendantOf(eFolder) then
                return true
            end
        end
        return false
    end

    if catName == "Emotes" then
        -- 只收集位於 Emotes 資料夾內部的【頂層】ModuleScript
        for _, eFolder in ipairs(emoteFolders) do
            for _, desc in ipairs(eFolder:GetDescendants()) do
                if desc:IsA("ModuleScript") and not desc:FindFirstAncestorWhichIsA("ModuleScript") and not seen[desc] then
                    seen[desc] = true
                    table.insert(results, desc)
                end
            end
        end
    else
        -- 不在 Emotes 底下的所有【頂層】ModuleScript 通通歸類為 Cosmetics
        for _, desc in ipairs(ITEMS_FOLDER:GetDescendants()) do
            if desc:IsA("ModuleScript") and not desc:FindFirstAncestorWhichIsA("ModuleScript") and not IsUnderEmotes(desc) and not seen[desc] then
                seen[desc] = true
                table.insert(results, desc)
            end
        end
    end
    
    return results
end

